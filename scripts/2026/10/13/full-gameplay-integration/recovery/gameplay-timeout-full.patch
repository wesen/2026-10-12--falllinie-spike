+void Particles::spray(int n,bool sparks,Vec3 p,Vec3 v,Quat q,Rng& rng){
+ Vec3 x=qrot(q,{1,0,0}),hv{v.x,0,v.z};double l=length(hv);Vec3 back=(l>1e-9?hv*(1/l):Vec3{0,0,1})*-1;
